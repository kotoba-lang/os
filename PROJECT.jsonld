  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": "https://schema.org",
          "@type": "DefinedTermSet",
          "@id": "https://os.etzhayyim.com/capabilities",
          "name": "Etzhayyim OS Capabilities (DoDAF CV-1)",
          "description": "Capability definitions for Etzhayyim OS — Web4 Local Interface",
          "hasDefinedTerm": [
            {
              "@type": "DefinedTerm",
              "@id": "cap:agent-runtime",
              "name": "Agent Runtime Environment",
              "description": "Local AI agent execution in WASM sandbox with resource limits, lifecycle management (spawn/stop/pause/resume), and local-cloud migration",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-001"
            },
            {
              "@type": "DefinedTerm",
              "@id": "cap:consent-gateway",
              "name": "Human Consent Gateway",
              "description": "Human-in-the-loop approval system for dangerous agent actions, with standing delegation support and TTL-based expiry",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-002"
            },
            {
              "@type": "DefinedTerm",
              "@id": "cap:agent-directory",
              "name": "Agent Directory & Trust Graph",
              "description": "Agent discovery across local/cloud/remote sources with compatible agent cards and user-managed trust levels",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-003"
            },
            {
              "@type": "DefinedTerm",
              "@id": "cap:resource-budget",
              "name": "Resource Budget Management",
              "description": "GCC token and compute resource budget enforcement per agent with pre-action checks, alerts, and emergency freeze",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-004"
            },
            {
              "@type": "DefinedTerm",
              "@id": "cap:audit-trail",
              "name": "Audit Trail",
              "description": "Immutable audit log for all agent actions (tool calls, transactions, communications, governance decisions) with searchable history",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-005"
            },
            {
              "@type": "DefinedTerm",
              "@id": "cap:local-cloud-sync",
              "name": "Local-Cloud State Sync",
              "description": "Bidirectional agent state synchronization between local Tauri and cloud SpinApp with offline queue and conflict resolution",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-006"
            },
            {
              "@type": "DefinedTerm",
              "@id": "cap:inference-mesh",
              "name": "Distributed Inference Mesh Node",
              "description": "Local GPU participation in Petals-style distributed inference mesh with GCC credit rewards",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-007"
            },
            {
              "@type": "DefinedTerm",
              "@id": "cap:drive-sync",
              "name": "Drive File Synchronization",
              "description": "Bidirectional file synchronization between local filesystem and cloud storage with project-hub git integration",
              "inDefinedTermSet": "https://os.etzhayyim.com/capabilities",
              "termCode": "CAP-OS-008"
            }
          ],
          "activity": [
            {
              "@type": "Action",
              "name": "Spawn Local Agent",
              "description": "Create and start a new AI agent in WASM sandbox with resource limits and GCC funding",
              "instrument": "cap:agent-runtime",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "Migrate Agent",
              "description": "Transfer agent state between local and cloud environments via sql graph gRPC message stream",
              "instrument": "cap:agent-runtime",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "Request Human Approval",
              "description": "Queue dangerous agent actions for human review with TTL-based expiry",
              "instrument": "cap:consent-gateway",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "Discover Agents",
              "description": "Search for agents across local, cloud, and remote cross-actor networks",
              "instrument": "cap:agent-directory",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "Enforce Budget",
              "description": "Pre-action GCC and compute budget check before agent tool execution",
              "instrument": "cap:resource-budget",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "Log Agent Action",
              "description": "Record agent tool calls, transactions, and governance decisions to immutable audit log",
              "instrument": "cap:audit-trail",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "Sync Agent State",
              "description": "Push/pull agent state between local and cloud with conflict detection",
              "instrument": "cap:local-cloud-sync",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "Participate in Mesh",
              "description": "Register local GPU in distributed inference mesh and earn GCC credits",
              "instrument": "cap:inference-mesh",
              "performer": "os-runtime-component"
            },
            {
              "@type": "Action",
              "name": "File Watch & Upload",
              "description": "Monitor local filesystem changes and upload to cloud storage",
              "instrument": "cap:drive-sync",
              "performer": "drive-sync-component"
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers"
            }
          ],
          "@type": "CreativeWork",
          "name": "etzhayyim-project-os Scheduler",
          "identifier": "etzhayyim-project-os/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "CreativeWork",
              "name": "Web4 OS WIT interface design (etzhayyim:os@0.1.0)",
              "status": "Completed",
              "dueDate": "2026-02-24"
            },
            {
              "@type": "CreativeWork",
              "name": "Implement os-runtime-component (TinyGo SpinApp)",
              "status": "Planned",
              "dueDate": "2026-03-15"
            },
            {
              "@type": "CreativeWork",
              "name": "Consent UI + Agent Dashboard in Tauri",
              "status": "Planned",
              "dueDate": "2026-03-30"
            },
            {
              "@type": "CreativeWork",
              "name": "Local-cloud migration + sync via sql graph",
              "status": "Planned",
              "dueDate": "2026-04-15"
            },
            {
              "@type": "CreativeWork",
              "name": "Budget enforcement + audit trail",
              "status": "Planned",
              "dueDate": "2026-04-30"
            }
          ],
          "blockers": [],
          "dateModified": "2026-02-24T00:00:00Z"
        }
      }
    ]
  }
