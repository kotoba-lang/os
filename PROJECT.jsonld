{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://os.etzhayyim.com",
  "name": "etzhayyim-project-os",
  "description": "Etzhayyim OS - Web4 Local Interface. Desktop operating environment that serves as the human's gateway to the agent-populated internet. Manages local AI agents (WASM sandbox), provides human-in-the-loop governance, economic budget enforcement via GCC tokens, and local-cloud state synchronization.",
  "url": "https://os.etzhayyim.com",
  "applicationCategory": "DesktopApplication",
  "operatingSystem": "macOS, Linux, Windows",
  "author": {
    "@type": "Organization",
    "name": "etzhayyim",
    "url": "https://etzhayyim.com"
  },
  "component": [
    {
      "@type": "SoftwareApplication",
      "name": "os-runtime-component",
      "description": "Core OS runtime. Exports 6 OS interfaces (agent-runtime, consent, directory, budget, audit, sync) via wRPC. World: etzhayyim-os-runtime.",
      "applicationCategory": "Runtime",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/os-runtime-component"
    },
    {
      "@type": "SoftwareApplication",
      "name": "os-ai-component",
      "description": "AI chat/completion via WebLLM (WebGPU) + OpenRouter fallback. World: etzhayyim-os-ai.",
      "applicationCategory": "AI",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/os-ai-component"
    },
    {
      "@type": "SoftwareApplication",
      "name": "os-messaging-component",
      "description": "Unified messaging (iMessage native bridge + WhatsApp + Gmail cloud). World: etzhayyim-os-messaging.",
      "applicationCategory": "Messaging",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/os-messaging-component"
    },
    {
      "@type": "SoftwareApplication",
      "name": "os-scheduler-component",
      "description": "Thread aggregation + AI-driven smart scheduling. World: etzhayyim-os-scheduler.",
      "applicationCategory": "Scheduling",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/os-scheduler-component"
    },
    {
      "@type": "SoftwareApplication",
      "name": "os-system-component",
      "description": "AV scan, privacy management, system optimization. World: etzhayyim-os-system.",
      "applicationCategory": "Security",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/os-system-component"
    },
    {
      "@type": "SoftwareApplication",
      "name": "os-wellbeing-component",
      "description": "Becoming journey, wellness dimensions tracking. World: etzhayyim-os-wellbeing.",
      "applicationCategory": "Wellbeing",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/os-wellbeing-component"
    },
    {
      "@type": "SoftwareApplication",
      "name": "os-ui",
      "description": "Web4 OS dedicated Svelte UI (dashboard, agents, consent, directory, budget, audit, sync, chat, messaging, scheduler, system, settings)",
      "applicationCategory": "Frontend",
      "programmingLanguage": "TypeScript",
      "runtimePlatform": "SvelteKit 2 (Static)",
      "path": "wasm/os-ui-6s80i2ya"
    },
    {
      "@type": "SoftwareApplication",
      "name": "sys-os",
      "description": "Tauri desktop shell (OAuth PKCE + auto-update). Serves local Svelte UI. No App runtime dependency.",
      "applicationCategory": "Desktop",
      "programmingLanguage": "Rust",
      "runtimePlatform": "Tauri v2 (Desktop)",
      "path": "legacy-runtime/sys-os-jt4qfzv1"
    },
    {
      "@type": "SoftwareApplication",
      "name": "drive-sync-component",
      "description": "Local-cloud file synchronization. World: etzhayyim-os-consumer.",
      "applicationCategory": "Storage",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/drive-sync-component"
    },
    {
      "@type": "SoftwareApplication",
      "name": "os-mcp-component",
      "description": "System info MCP endpoint for OS monitoring. World: etzhayyim-mcp.",
      "applicationCategory": "Monitoring",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/os-mcp-component"
    }
  ],
